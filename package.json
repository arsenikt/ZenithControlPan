{
  "name": "zenith-control-panel",
  "version": "1.0.0",
  "description": "Deployment, contract operations and monitoring console for Zenith EVM Testnet",
  "author": "doepic.cc",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5175 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5175 electron .\"",
    "compile:contracts": "node scripts/compile-contracts.mjs",
    "icon": "python scripts/generate-icon.py",
    "typecheck": "tsc --noEmit",
    "build": "npm run compile:contracts && npm run typecheck && vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test": "node --test tests/*.test.mjs",
    "test:electron": "electron tests/electron-smoke"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.7",
    "ethers": "^6.15.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "solc": "0.8.30"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "cc.doepic.zenith.controlpanel",
    "productName": "Zenith Control Panel",
    "asar": true,
    "directories": { "output": "release" },
    "extraResources": [
      { "from": "build/icon.ico", "to": "icon.ico" },
      { "from": "build/icon.png", "to": "icon.png" }
    ],
    "files": ["dist/**/*", "electron/**/*", "node_modules/solc/**/*", "package.json"],
    "win": { "icon": "build/icon.ico", "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Zenith Control Panel"
    }
  }
}
